@model IReadOnlyList<UserListDto>
@using System.Security.Claims

@{
    ViewData["Title"] = "Kullanıcılar";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var apiError = ViewData["ApiError"] as string;
}

<section class="page-heading">
    <div>
        <p class="eyebrow">03 / KORUMALI SAYFA</p>
        <h1>Kullanıcılar</h1>
        <p>API'deki kullanıcılar, giriş yaptığın oturumun JWT'si ile getirildi.</p>
    </div>

    <a class="button button-secondary"
       asp-controller="User"
       asp-action="Index">
        Listeyi yenile ↻
    </a>
</section>

<div class="status-strip">
    <span class="badge badge-success">MVC: oturum açık</span>
    <span class="badge">API: JWT ile erişim</span>

    @if (apiError == null)
    {
        <span class="result-count">@Model.Count kullanıcı</span>
    }
</div>

@if (apiError != null)
{
    <div class="notice notice-error" role="alert">@apiError</div>
}
else if (Model.Count == 0)
{
    <div class="panel empty-state">
        <h2>Henüz kullanıcı yok.</h2>
        <p>API boş bir kullanıcı listesi döndürdü.</p>
    </div>
}
else
{
    <div class="panel table-panel">
        <div class="table-scroll">
            <table>
                <caption class="sr-only">API'den getirilen kayıtlı kullanıcılar</caption>

                <thead>
                    <tr>
                        <th scope="col">Kullanıcı</th>
                        <th scope="col">E-posta</th>
                        <th scope="col">Roller</th>
                        <th scope="col">Kullanıcı ID</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <span class="avatar" aria-hidden="true">
                                        @(string.IsNullOrWhiteSpace(user.NameSurname)
                                            ? "?"
                                            : user.NameSurname.Trim()[..1].ToUpperInvariant())
                                    </span>

                                    <div>
                                        <strong>@user.NameSurname</strong>
                                        <span class="user-detail">@user.UserName</span>

                                        @if (user.Id == currentUserId)
                                        {
                                            <span class="badge badge-current">Sen</span>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td>@user.Email</td>

                            <td>
                                <div class="role-list">
                                    @if (user.Roles.Length == 0)
                                    {
                                        <span class="muted">Rol atanmamış</span>
                                    }
                                    else
                                    {
                                        foreach (var role in user.Roles)
                                        {
                                            <span class="badge">@role</span>
                                        }
                                    }
                                </div>
                            </td>

                            <td>
                                <code class="user-id">@user.Id</code>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
